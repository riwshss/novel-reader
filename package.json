{
  "name": "novel-reader",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "iPhone 用的離線 TXT 小說閱讀器（PWA）",
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "lint:compat": "eslint js",
    "e2e": "npm run build && node e2e/run.mjs",
    "serve": "npx --yes http-server -p 8765 -c-1 ."
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-compat": "^7.0.2",
    "playwright": "^1.55.0"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "tweetnacl": "^1.0.3"
  },
  "browserslist": [
    "ios_saf >= 10"
  ]
}
